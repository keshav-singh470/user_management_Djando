								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.access) {",
									"        pm.collectionVariables.set(\"access_token\", jsonData.access);",
									"        console.log(\"Access token automatically saved in collection variables!\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"keshav.ptu21@gmail.com\",\n    \"password\": \"keshav.ptu21@123\"\n}"
						},
