        {
          "name": "Create User (Success - profile required)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Rahul\",\n  \"last_name\": \"Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"profiles\": \"Developer\",\n  \"phone\": \"9876543210\",\n  \"gender\": \"male\",\n  \"blood_group\": \"o+\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "profiles is REQUIRED. Use an existing profile name (case-insensitive)."
          }
        },
        {
          "name": "Create User - New Profile Auto-Created",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Neha\",\n  \"last_name\": \"Verma\",\n  \"email\": \"neha.verma@example.com\",\n  \"profiles\": \"QA Engineer\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "If the profile name does not exist, a new (non-default, deletable) profile is created automatically."
          }
        },
        {
          "name": "Create User - Missing Profile (400)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/",
