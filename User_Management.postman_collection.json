            ]
          }
        },
        {
          "name": "List Inactive Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/?status=inactive",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ],
              "query": [
                {
                  "key": "status",
                  "value": "inactive"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
