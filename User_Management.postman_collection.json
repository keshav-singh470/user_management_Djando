{
  "info": {
    "name": "User Management APIs",
    "_postman_id": "um-complete-suite-2026",
    "description": "End-to-end API collection: Auth, Users, Profiles (default + custom), Clients, Projects (with attachments inside the Project API) and Restore APIs, with positive and negative cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & OTP",
      "item": [
        {
          "name": "Login (Success - Auto Saves Token)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"keshav.ptu21@gmail.com\",\n  \"password\": \"your_password\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh);",
                  "    pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "    pm.test('Received JWT access token', () => pm.expect(json.access).to.be.a('string'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Wrong Password (401)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"keshav.ptu21@gmail.com\",\n  \"password\": \"wrongpass123\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Login - Missing Email (400)",
