        {
          "name": "Login (Success - Auto Saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh);",
                  "    pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "    pm.test('Received JWT access token', () => pm.expect(json.access).to.be.a('string'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"keshav.ptu21@gmail.com\",\n  \"password\": \"your_password\"\n}"
            }
          }
        },
        {
          "name": "Login - Wrong Password (401)",
